with "config/ahc_config.gpr";
project Ahc is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ahc_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ahc_main.adb");

   package Builder is
      for Executable ("ahc_main.adb") use "ahc";
   end Builder;

   package Compiler is
      for Default_Switches ("Ada") use Ahc_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ahc;
